  <metadata xmlns:dc="http://purl.org/dc/elements/1.1/">
    <dc:identifier id="bookid">urn:uuid:d9fac576-7f3c-3f3e-f543-491c6a878e4b</dc:identifier>
    <dc:title>Merlin's Apprentice: Magic Has a Price. He Was It.</dc:title>
    <dc:creator>Asif M. Shah</dc:creator>
    <dc:language>en</dc:language>
    <dc:description>A dark fantasy about a seventeen-year-old apprentice who expected to learn magic and instead inherited a kingdom — and the price of becoming indispensable.</dc:description>
    <dc:subject>Fantasy</dc:subject>
    <dc:subject>Dark Fantasy</dc:subject>
    <dc:subject>Coming of Age</dc:subject>
    <dc:subject>Literary Fantasy</dc:subject>
    <dc:rights>Copyright 2026 Asif M. Shah</dc:rights>
    <meta property="dcterms:modified">2026-03-21T00:00:00Z</meta>
  </metadata>
