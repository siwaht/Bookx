{
  "$schema": "node_modules/wrangler/config-schema.json",
  // LOCAL TESTING ONLY (see worker/dev-bridge.ts): the real Worker with local
  // D1 and R2, forwarding to an app process outside a container, for machines
  // where `wrangler dev` cannot run Containers (Windows). Deliberately has no
  // public URL; production is wrangler.jsonc.
  "name": "bookx-dev-bridge",
  "main": "worker/dev-bridge.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/manus-storage/*", "/__bridge/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "bookx" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "bookx-audio" }],
  "vars": { "BRIDGE_APP_URL": "http://127.0.0.1:3100" },
  "access": {
    "dev": {
      "aud": "bookx-local-dev",
      "identity": { "email": "creator@bookx.local", "name": "Local creator" }
    }
  }
}
