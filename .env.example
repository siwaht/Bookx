# Copy to `.env` for a local checkout and fill in. On Cloudflare the same
# settings are Worker secrets and variables (see wrangler.jsonc); nothing here
# is needed there except the provider keys, which become secrets.

# ---------------------------------------------------------------------------
# Core runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
# `server/_core/index.ts` scans upward from this port for a free one.
PORT=3001

# ---------------------------------------------------------------------------
# Sign-in (local checkout)
# ---------------------------------------------------------------------------
# HS256 signing key for the local session cookie. Use 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# One-click sign-in at /api/dev/login for a local checkout. Never set this in
# production; it is ignored when NODE_ENV=production.
BOOKX_DEV_LOGIN=1

# ---------------------------------------------------------------------------
# Database and files (local checkout)
# ---------------------------------------------------------------------------
# A local SQLite file with the same schema as Cloudflare D1. It is created and
# migrated on first use. Default: data/bookx.sqlite
BOOKX_SQLITE_PATH=
# Where audio, sounds and exports are stored locally. Default: data/storage
BOOKX_LOCAL_STORAGE_DIR=data/storage

# ---------------------------------------------------------------------------
# Providers: each one is optional and detected independently
# ---------------------------------------------------------------------------
# Text-to-speech, the voice catalog and sound effects. Keys start with "sk_".
ELEVENLABS_API_KEY=

# Text-to-speech (aura-*) and speech-to-text (nova-*).
DEEPGRAM_API_KEY=

# Text-to-speech, speech-to-text and the casting language model.
OPENAI_API_KEY=

# Cloudflare Workers AI: text-to-speech (Aura-2) and the language model used
# for casting and scene analysis.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional AI Gateway id, sent as `cf-aig-gateway-id` in native mode.
CLOUDFLARE_GATEWAY_ID=

# Optional: path to an ffmpeg binary. By default the one bundled with the
# ffmpeg-static package is used, then `ffmpeg` on the PATH.
FFMPEG_PATH=
