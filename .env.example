# Copy to `.env` and fill in. Every variable below is read somewhere in
# `server/`; anything left blank degrades a specific feature rather than
# crashing the process, except where marked REQUIRED.

# ---------------------------------------------------------------------------
# Core runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
# `server/_core/index.ts` scans upward from this port for a free one.
PORT=3001

# ---------------------------------------------------------------------------
# Auth — REQUIRED for sign-in
# ---------------------------------------------------------------------------
# HS256 signing key for the session cookie. Use 32+ random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without this, session tokens cannot be signed or verified and every request
# is anonymous.
JWT_SECRET=

# Manus OAuth. `VITE_APP_ID` is the client id, `OAUTH_SERVER_URL` the token
# endpoint host. Both are needed for `/api/oauth/callback` to complete.
VITE_APP_ID=
OAUTH_SERVER_URL=

# openId that is granted the `admin` role on first sign-in. Optional.
OWNER_OPEN_ID=

# ---------------------------------------------------------------------------
# Database — REQUIRED to persist projects
# ---------------------------------------------------------------------------
# MySQL connection string (drizzle-orm/mysql2), e.g.
# mysql://user:password@127.0.0.1:3306/bookx
# `getDb()` returns null when unset: the app still renders, but every
# persistence route fails with "Database unavailable" and the integration tests
# in `server/*.test.ts` skip.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Object storage (audio renders, previews, podcast source uploads)
# ---------------------------------------------------------------------------
# Required by `server/storage.ts`; without both, any route that writes audio
# throws "Storage config missing".
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ---------------------------------------------------------------------------
# Providers — each one is optional and independently detected
# ---------------------------------------------------------------------------
# Text-to-speech + voice catalog.
ELEVENLABS_API_KEY=

# Text-to-speech (aura-*) + speech-to-text (nova-*).
DEEPGRAM_API_KEY=

# Text-to-speech, speech-to-text and the casting language model.
OPENAI_API_KEY=

# Cloudflare Workers AI. Set the account id + token, or point a saved provider
# connection at an OpenAI-compatible gateway from the Settings page.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional AI Gateway id, sent as `cf-aig-gateway-id` in native mode.
CLOUDFLARE_GATEWAY_ID=
